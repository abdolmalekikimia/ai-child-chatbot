# Copy to config/local.env (git-ignored) and fill in. Never commit real values. Placeholders only.
CHATQA_BASE_URL=https://test-env.example.invalid
CHATQA_ACCESS_KEY=
# Routes of the system under test (defaults are generic; override to match your service):
# CHATQA_ROUTE_SESSION=/api/auth/session
# CHATQA_ROUTE_TOKEN=/api/auth/token
# CHATQA_ROUTE_SCENARIOS=/api/scenarios
# CHATQA_ROUTE_STREAM=/api/realtime/stream
# Private CA or pinned certificate for the test environment (TLS verification stays ON):
# CHATQA_CA_FILE=config/certs/test-env.pem
# Read-only QA data store (privacy and memory checks):
CHATQA_DB_HOST=
CHATQA_DB_PORT=
CHATQA_DB_NAME=qa_data_store
CHATQA_DB_USER=
CHATQA_DB_PASSWORD=
CHATQA_DB_SSLMODE=verify-full
# CHATQA_DB_CA_FILE=config/certs/qa-data-store.pem
# CHATQA_INTRO_SQL=select kind, value from memory_store.intro_items order by 1, 2
# CHATQA_MEMORY_SQL=select note from memory_store.memory_notes order by 1
# Where the service writes logs (files/folders separated by ; ) or its container name:
CHATQA_LOG_PATHS=
CHATQA_LOG_CONTAINER=
# Local results database (SQL Server, Windows login). Set CHATQA_QA_SQL=0 to turn it off:
# CHATQA_QA_SQL=1
# CHATQA_QA_SQL_SERVER=localhost
